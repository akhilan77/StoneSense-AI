# ==============================================================================
# StoneSense-AI Environment Configuration Template
# Copy this file to .env and configure values before starting services.
# ==============================================================================

# Application Environment (development | staging | production)
STONESENSE_ENV=development
ENVIRONMENT=development

# Database Connection URL (SQLite or PostgreSQL)
# Local SQLite example: sqlite:///stonesense.db
# PostgreSQL example:   postgresql://stonesense_user:stonesense_password@postgres:5432/stonesense_db
STONESENSE_DATABASE_URL=sqlite:///stonesense.db
DATABASE_URL=sqlite:///stonesense.db

# Authentication / JWT Secret Key
# REQUIRED in production mode. In development mode, a fallback key is used if empty.
STONESENSE_JWT_SECRET=your_strong_random_jwt_secret_here_min_32_chars
JWT_SECRET_KEY=your_strong_random_jwt_secret_here_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SEC=60

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:80,http://127.0.0.1:80

# Deployment Gate Thresholds (DL Clinical Models)
GATE_MIN_ACCURACY=0.95
GATE_MIN_F1=0.94
GATE_MAX_REGRESSION_VS_CURRENT=0.02
GATE_MIN_RECALL_STONE=0.96
GATE_MIN_RECALL_TUMOR=0.98
GATE_VALIDATION_DATA_SOURCE=dl_partitions_iid_seed42_val

# Docker Compose Database Credentials
POSTGRES_USER=stonesense_user
POSTGRES_PASSWORD=replace_with_secure_db_password
POSTGRES_DB=stonesense_db
POSTGRES_PORT=5432
